AI_PROVIDER=inception
INCEPTION_API_KEY=your_inception_key_here
INCEPTION_MODEL=mercury-2

# Optional:
# INCEPTION_BASE_URL=https://api.inceptionlabs.ai/v1
# INCEPTION_REASONING_EFFORT=low
# HOST=0.0.0.0
# PORT=3000
# Test-only placeholder responses (never use for the Flutter app):
# ALLOW_MOCK_FACTS=true

# Cerebras is still supported:
# AI_PROVIDER=cerebras
# CEREBRAS_API_KEY=your_cerebras_key_here
# CEREBRAS_MODEL=gemma-4-31b

# OpenAI is still supported:
# AI_PROVIDER=openai
# OPENAI_API_KEY=your_openai_key_here
# OPENAI_MODEL=gpt-4.1-mini
# OPENAI_MAX_COMPLETION_TOKENS=7600
